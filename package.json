{
  "name": "ghost-ui-native",
  "version": "0.1.6",
  "description": "Ghost UI — React Native components with NativeWind, theming, and a source-install CLI.",
  "license": "MIT",
  "author": {
    "name": "Muhammad Kashif",
    "url": "https://kashif-dev.site"
  },
  "homepage": "https://ghost-ui.kashif-dev.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithkashi/ghost-ui-native.git"
  },
  "bugs": {
    "url": "https://github.com/codewithkashi/ghost-ui-native/issues"
  },
  "keywords": [
    "ghost-ui",
    "react-native",
    "nativewind",
    "ui",
    "components",
    "design-system",
    "tailwind",
    "cli"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "ghost-ui": "./cli/ghost-ui.mjs"
  },
  "files": [
    "src",
    "cli",
    "registry.json",
    "LICENSE",
    "README.md",
    "SETUP.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "ghost-ui": "node ./cli/ghost-ui.mjs",
    "doctor": "node ./cli/ghost-ui.mjs doctor",
    "prepublishOnly": "node ./cli/ghost-ui.mjs list"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "@react-native-community/blur": ">=4.4.0",
    "lucide-react-native": ">=0.400.0",
    "nativewind": ">=4.0.0 <5",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "lucide-react-native": {
      "optional": true
    },
    "@react-native-community/blur": {
      "optional": true
    }
  }
}
